# Host directory exposed to agents as /workspace.
GITHUB_ROOT=/Users/your-name/Github

# The container is local-only when bound to 127.0.0.1.
# Deliberately use 0.0.0.0 only when another device needs to connect.
SSH_BIND_ADDRESS=127.0.0.1
SSH_PORT=49222

# Match the host user's UID. The GID can be a container-local value.
AGENT_UID=501
AGENT_GID=501

# Timezone used inside the container.
TZ=UTC

# Pinned tool versions. Update deliberately, then rebuild.
CODEX_VERSION=0.146.0
CLAUDE_CODE_VERSION=2.1.220
HERDR_VERSION=0.7.5
MOSHI_HOOK_VERSION=v0.2.66
