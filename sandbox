#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
managed_env_file="${config_home}/agent-toolbox/agent-sandbox.env"
managed_mounts_file="${config_home}/agent-toolbox/compose.mounts.yaml"
local_env_file="${project_dir}/.env"
local_mounts_file="${project_dir}/compose.mounts.yaml"
mount_tool="${project_dir}/scripts/manage-mounts.cjs"

usage() {
  cat <<'EOF'
Usage: ./sandbox COMMAND

Commands:
  build                            Build or rebuild the image
  up                               Start or apply configuration to the sandbox
  down                             Stop without deleting persistent volumes
  restart                          Restart the existing container
  shell                            Open a local shell as the agent user
  logs                             Follow container logs
  status                           Show container, tool, SSH, and Moshi status
  config                           Show the merged Docker Compose configuration
  test                             Run the host-side test suite
  camunda enable-host [BASE_URL]   Add the explicit host-local c8ctl profile
  camunda status                   Check the opt-in host cluster connection
  camunda disable-host             Remove the host-local c8ctl profile
  mount list                       List configured bind mounts
  mount add SOURCE TARGET [--read-only]
                                   Add a bind mount without applying it
  mount remove TARGET              Remove a bind mount without applying it
  versions                         Print installed tool versions
  authorize-key [KEY]              Add an Ed25519 SSH public key
  keys                             List authorized SSH key fingerprints
  host-key                         Print the sandbox SSH host-key fingerprint
  codex-login                      Authenticate Codex using device authorization
  claude-login                     Authenticate Claude Code
  gh-login                         Authenticate GitHub CLI over HTTPS
  moshi-pair                       Pair Moshi agent hooks
  moshi-install                    Refresh hooks for both agent CLIs
EOF
}

if [[ -n "${AGENT_TOOLBOX_MOUNTS_FILE:-}" ]]; then
  mounts_file="${AGENT_TOOLBOX_MOUNTS_FILE}"
elif [[ -f "${managed_mounts_file}" ]]; then
  mounts_file="${managed_mounts_file}"
elif [[ -f "${local_mounts_file}" ]]; then
  mounts_file="${local_mounts_file}"
else
  mounts_file="${managed_mounts_file}"
fi

command_name="${1:-}"
if [[ -n "${command_name}" ]]; then
  shift
fi

case "${command_name}" in
  help|-h|--help|"")
    usage
    exit 0
    ;;
  test)
    exec node --test "${project_dir}"/tests/*.test.cjs
    ;;
  mount)
    mount_action="${1:-list}"
    if (($# > 0)); then
      shift
    fi
    case "${mount_action}" in
      list|add|remove)
        exec node "${mount_tool}" "${mount_action}" "${mounts_file}" "$@"
        ;;
      help|-h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown mount command: ${mount_action}" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
esac

if [[ -n "${AGENT_TOOLBOX_ENV_FILE:-}" ]]; then
  env_file="${AGENT_TOOLBOX_ENV_FILE}"
elif [[ -f "${managed_env_file}" ]]; then
  env_file="${managed_env_file}"
else
  env_file="${local_env_file}"
fi

if [[ ! -f "${env_file}" ]]; then
  if [[ -n "${AGENT_TOOLBOX_ENV_FILE:-}" ]]; then
    echo "Configured environment file does not exist: ${env_file}" >&2
    exit 1
  fi

  cp "${project_dir}/.env.example" "${local_env_file}"
  echo "Created ${local_env_file}; review it, then rerun the command." >&2
  echo "For Stow-managed settings, use ${managed_env_file}." >&2
  exit 1
fi

if [[ ! -f "${mounts_file}" ]]; then
  echo "Mount configuration does not exist: ${mounts_file}" >&2
  echo "Create it with: ./sandbox mount add /absolute/host/path /workspace" >&2
  exit 1
fi

compose=(
  docker compose
  --project-directory "${project_dir}"
  --env-file "${env_file}"
  --file "${project_dir}/compose.yaml"
)

node "${mount_tool}" validate "${mounts_file}"
compose+=(--file "${mounts_file}")

case "${command_name}" in
  build)
    exec "${compose[@]}" build
    ;;
  up)
    exec "${compose[@]}" up --detach
    ;;
  down)
    exec "${compose[@]}" down
    ;;
  restart)
    exec "${compose[@]}" restart
    ;;
  shell)
    exec "${compose[@]}" exec --user agent sandbox zsh --login
    ;;
  logs)
    exec "${compose[@]}" logs --follow sandbox
    ;;
  config)
    exec "${compose[@]}" config
    ;;
  camunda)
    camunda_action="${1:-status}"
    if (($# > 0)); then
      shift
    fi
    case "${camunda_action}" in
      enable-host|status|disable-host)
        exec "${compose[@]}" exec --user agent sandbox \
          camunda-host "${camunda_action}" "$@"
        ;;
      *)
        echo "Unknown Camunda command: ${camunda_action}" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  versions)
    exec "${compose[@]}" exec --user agent sandbox bash -lc \
      'node --version; python --version; uv --version; java --version; mvn --version; gh --version | head -1; nvim --version | head -1; starship --version; tree-sitter --version; mosh-server --version | head -1; c8ctl --version; codex --version; claude --version; herdr --version; moshi-hook version'
    ;;
  authorize-key)
    if (($# > 0)); then
      printf '%s\n' "$*" |
        "${compose[@]}" exec --no-TTY --user agent sandbox add-authorized-key
    else
      "${compose[@]}" exec --no-TTY --user agent sandbox add-authorized-key
    fi
    ;;
  keys)
    exec "${compose[@]}" exec --user agent sandbox bash -lc \
      'if [[ -s ~/.ssh/authorized_keys ]]; then ssh-keygen -lf ~/.ssh/authorized_keys; else echo "No keys authorized."; fi'
    ;;
  host-key)
    exec "${compose[@]}" exec sandbox \
      ssh-keygen -lf /etc/ssh/host_keys/ssh_host_ed25519_key.pub
    ;;
  codex-login)
    exec "${compose[@]}" exec --user agent sandbox codex login --device-auth
    ;;
  claude-login)
    exec "${compose[@]}" exec --user agent sandbox claude auth login
    ;;
  gh-login)
    "${compose[@]}" exec --user agent sandbox \
      gh auth login --web --git-protocol https
    "${compose[@]}" exec --user agent sandbox gh auth setup-git
    ;;
  moshi-pair)
    read -r -s -p "Moshi Agent Hooks token: " moshi_token
    printf '\n'
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook pair --token "${moshi_token}" --store file
    unset moshi_token
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook install --target codex --target claude
    "${compose[@]}" restart sandbox
    ;;
  moshi-install)
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook install --target codex --target claude
    "${compose[@]}" restart sandbox
    ;;
  status)
    "${compose[@]}" ps
    if "${compose[@]}" ps --status running --quiet sandbox | grep -q .; then
      printf '\nTool versions:\n'
      "${compose[@]}" exec --user agent sandbox bash -lc \
        'node --version; python --version; java --version; mvn --version | head -1; gh --version | head -1; nvim --version | head -1; starship --version; tree-sitter --version; mosh-server --version | head -1; c8ctl --version; codex --version; claude --version; herdr --version; moshi-hook version'
      printf '\nSSH configuration:\n'
      "${compose[@]}" exec sandbox /usr/sbin/sshd -t
      echo "valid"
      printf '\nMoshi hook:\n'
      "${compose[@]}" exec --user agent sandbox moshi-hook status || true
    fi
    ;;
  *)
    echo "Unknown command: ${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
