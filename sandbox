#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
local_env_file="${project_dir}/.env"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
managed_env_file="${config_home}/agent-toolbox/agent-sandbox.env"

if [[ -n "${AGENT_TOOLBOX_ENV_FILE:-}" ]]; then
  env_file="${AGENT_TOOLBOX_ENV_FILE}"
elif [[ -f "${managed_env_file}" ]]; then
  env_file="${managed_env_file}"
else
  env_file="${local_env_file}"
fi

if [[ ! -f "${env_file}" ]]; then
  if [[ -n "${AGENT_TOOLBOX_ENV_FILE:-}" ]]; then
    echo "Configured environment file does not exist: ${env_file}" >&2
    exit 1
  fi

  cp "${project_dir}/.env.example" "${local_env_file}"
  echo "Created ${local_env_file}; review it, then rerun the command." >&2
  echo "For Stow-managed settings, use ${managed_env_file}." >&2
  exit 1
fi

compose=(
  docker compose
  --project-directory "${project_dir}"
  --env-file "${env_file}"
  --file "${project_dir}/compose.yaml"
)

usage() {
  cat <<'EOF'
Usage: ./sandbox COMMAND

Commands:
  build                 Build or rebuild the image
  up                    Start the sandbox
  down                  Stop the sandbox without deleting persistent volumes
  restart               Restart the sandbox
  shell                 Open a local shell as the agent user
  logs                  Follow container logs
  status                Show container, tool, SSH, and Moshi status
  versions              Print Codex, Claude Code, Herdr, and Moshi versions
  authorize-key [KEY]   Add an Ed25519 SSH public key; reads stdin when omitted
  keys                  List authorized SSH key fingerprints
  host-key              Print the sandbox SSH host-key fingerprint
  codex-login           Authenticate Codex using device authorization
  claude-login          Authenticate Claude Code
  moshi-pair            Pair moshi-hook using a token entered without echo
  moshi-install         Install or refresh hooks for both agent CLIs
EOF
}

command_name="${1:-}"
if [[ -n "${command_name}" ]]; then
  shift
fi

case "${command_name}" in
  build)
    exec "${compose[@]}" build
    ;;
  up)
    exec "${compose[@]}" up --detach
    ;;
  down)
    exec "${compose[@]}" down
    ;;
  restart)
    exec "${compose[@]}" restart
    ;;
  shell)
    exec "${compose[@]}" exec --user agent sandbox bash --login
    ;;
  logs)
    exec "${compose[@]}" logs --follow sandbox
    ;;
  versions)
    exec "${compose[@]}" exec --user agent sandbox bash -lc \
      'codex --version; claude --version; herdr --version; moshi-hook version'
    ;;
  authorize-key)
    if (($# > 0)); then
      printf '%s\n' "$*" | "${compose[@]}" exec --no-TTY --user agent sandbox add-authorized-key
    else
      "${compose[@]}" exec --no-TTY --user agent sandbox add-authorized-key
    fi
    ;;
  keys)
    exec "${compose[@]}" exec --user agent sandbox bash -lc \
      'if [[ -s ~/.ssh/authorized_keys ]]; then ssh-keygen -lf ~/.ssh/authorized_keys; else echo "No keys authorized."; fi'
    ;;
  host-key)
    exec "${compose[@]}" exec sandbox \
      ssh-keygen -lf /etc/ssh/host_keys/ssh_host_ed25519_key.pub
    ;;
  codex-login)
    exec "${compose[@]}" exec --user agent sandbox codex login --device-auth
    ;;
  claude-login)
    exec "${compose[@]}" exec --user agent sandbox claude auth login
    ;;
  moshi-pair)
    read -r -s -p "Moshi Agent Hooks token: " moshi_token
    printf '\n'
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook pair --token "${moshi_token}" --store file
    unset moshi_token
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook install --target codex --target claude
    "${compose[@]}" restart sandbox
    ;;
  moshi-install)
    "${compose[@]}" exec --user agent sandbox \
      moshi-hook install --target codex --target claude
    "${compose[@]}" restart sandbox
    ;;
  status)
    "${compose[@]}" ps
    if "${compose[@]}" ps --status running --quiet sandbox | grep -q .; then
      printf '\nTool versions:\n'
      "${compose[@]}" exec --user agent sandbox bash -lc \
        'codex --version; claude --version; herdr --version; moshi-hook version'
      printf '\nSSH configuration:\n'
      "${compose[@]}" exec sandbox /usr/sbin/sshd -t
      echo "valid"
      printf '\nMoshi hook:\n'
      "${compose[@]}" exec --user agent sandbox moshi-hook status || true
    fi
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "Unknown command: ${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
